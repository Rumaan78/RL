import numpy as np
import random
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam
import matplotlib.pyplot as plt

# Simulated 3D Environment - Simple Grid World Example
class Simple3DEnv:
    def __init__(self):
        self.state_space = 100  # 100 possible states
        self.action_space = 6  # 6 possible actions (e.g., move in 6 directions)
        self.state = 0
        self.done = False

    def reset(self):
        self.state = random.randint(0, self.state_space - 1)
        self.done = False
        return self.state

    def step(self, action):
        reward = -1
        if action == self.state + 1:  # Simplified win condition
            reward = 10
            self.done = True
        self.state = (self.state + action) % self.state_space  # Simple state update
        return self.state, reward, self.done

# Define the Model (Q-Network)
def create_model():
    model = Sequential([
        Dense(128, input_dim=100, activation='relu'),
        Dense(128, activation='relu'),
        Dense(6, activation='linear')  # Output Q-values for each action
    ])
    model.compile(loss='mse', optimizer=Adam(lr=0.001))
    return model

# DQN Agent
class DQNAgent:
    def __init__(self):
        self.model = create_model()
        self.epsilon = 0.1
        self.gamma = 0.9
        self.memory = []
        self.batch_size = 32

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.randint(0, 5)
        q_values = self.model.predict(state.reshape(1, 100))
        return np.argmax(q_values[0])

    def replay(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                target = reward + self.gamma * np.max(self.model.predict(next_state.reshape(1, 100))[0])
            target_f = self.model.predict(state.reshape(1, 100))
            target_f[0][action] = target
            self.model.fit(state.reshape(1, 100), target_f, epochs=1, verbose=0)

# DDQN Agent
class DDQNAgent:
    def __init__(self):
        self.online_model = create_model()
        self.target_model = create_model()
        self.epsilon = 0.1
        self.gamma = 0.9
        self.memory = []
        self.batch_size = 32

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.randint(0, 5)
        q_values = self.online_model.predict(state.reshape(1, 100))
        return np.argmax(q_values[0])

    def replay(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                next_action = np.argmax(self.online_model.predict(next_state.reshape(1, 100))[0])
                target = reward + self.gamma * self.target_model.predict(next_state.reshape(1, 100))[0][next_action]
            target_f = self.online_model.predict(state.reshape(1, 100))
            target_f[0][action] = target
            self.online_model.fit(state.reshape(1, 100), target_f, epochs=1, verbose=0)

    def update_target(self):
        self.target_model.set_weights(self.online_model.get_weights())

# Training function for both agents
def train_agents(agent_type):
    env = Simple3DEnv()
    agent = DQNAgent() if agent_type == 'DQN' else DDQNAgent()
    episodes = 500
    rewards = []
    for episode in range(episodes):
        state = env.reset()
        done = False
        total_reward = 0
        while not done:
            state_input = np.zeros(100)  # Simplified state representation
            state_input[state] = 1
            action = agent.act(state_input)
            next_state, reward, done = env.step(action)
            next_state_input = np.zeros(100)
            next_state_input[next_state] = 1
            agent.remember(state_input, action, reward, next_state_input, done)
            agent.replay()
            if agent_type == 'DDQN' and episode % 10 == 0:
                agent.update_target()  # Update target network periodically
            state = next_state
            total_reward += reward
        rewards.append(total_reward)
    return rewards

# Run training for both DQN and DDQN
dqn_rewards = train_agents('DQN')
ddqn_rewards = train_agents('DDQN')

# Plot performance comparison
plt.plot(dqn_rewards, label="DQN")
plt.plot(ddqn_rewards, label="DDQN")
plt.xlabel('Episodes')
plt.ylabel('Total Reward')
plt.legend()
plt.show()
