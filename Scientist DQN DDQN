import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, Model
import random
import gym

class DQNAgent:
    def __init__(self, state_size, action_size, alpha=0.001, gamma=0.99, epsilon=1.0, epsilon_decay=0.995):
        self.state_size = state_size
        self.action_size = action_size
        self.alpha = alpha  # Learning rate
        self.gamma = gamma  # Discount factor
        self.epsilon = epsilon  # Exploration rate
        self.epsilon_decay = epsilon_decay  # Decay rate for exploration
        self.memory = []  # Experience replay
        self.model = self.build_model()  # Build Q-network

    def build_model(self):
        model = tf.keras.Sequential([
            layers.Dense(64, input_dim=self.state_size, activation='relu'),
            layers.Dense(64, activation='relu'),
            layers.Dense(self.action_size, activation='linear')  # Output Q-values for each action
        ])
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.alpha), loss='mse')
        return model

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.randrange(self.action_size)  # Explore action space
        q_values = self.model.predict(state)
        return np.argmax(q_values[0])  # Exploit learned knowledge

    def replay(self, batch_size):
        batch = random.sample(self.memory, batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                target += self.gamma * np.max(self.model.predict(next_state)[0])
            target_f = self.model.predict(state)
            target_f[0][action] = target
            self.model.fit(state, target_f, epochs=1, verbose=0)
        if self.epsilon > 0.01:
            self.epsilon *= self.epsilon_decay  # Decay epsilon to reduce exploration

# Double DQN Implementation
class DDQNAgent(DQNAgent):
    def build_model(self):
        model = tf.keras.Sequential([
            layers.Dense(64, input_dim=self.state_size, activation='relu'),
            layers.Dense(64, activation='relu'),
            layers.Dense(self.action_size, activation='linear')  # Output Q-values for each action
        ])
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.alpha), loss='mse')
        self.target_model = self.build_target_model()  # Target model for DDQN
        return model
    
    def build_target_model(self):
        model = tf.keras.Sequential([
            layers.Dense(64, input_dim=self.state_size, activation='relu'),
            layers.Dense(64, activation='relu'),
            layers.Dense(self.action_size, activation='linear')
        ])
        model.set_weights(self.model.get_weights())  # Initialize target model weights
        return model

    def update_target_model(self):
        self.target_model.set_weights(self.model.get_weights())

    def replay(self, batch_size):
        batch = random.sample(self.memory, batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                next_action = np.argmax(self.model.predict(next_state)[0])
                target = reward + self.gamma * self.target_model.predict(next_state)[0][next_action]
            target_f = self.model.predict(state)
            target_f[0][action] = target
            self.model.fit(state, target_f, epochs=1, verbose=0)
        if self.epsilon > 0.01:
            self.epsilon *= self.epsilon_decay  # Decay epsilon to reduce exploration

        self.update_target_model()  # Update target model with current model

# Dueling DQN Implementation
class DuelingDQNAgent(DQNAgent):
    def build_model(self):
        inputs = layers.Input(shape=(self.state_size,))
        x = layers.Dense(64, activation='relu')(inputs)
        x = layers.Dense(64, activation='relu')(x)

        # Advantage and Value streams
        advantage = layers.Dense(self.action_size)(x)
        value = layers.Dense(1)(x)

        # Combine the two streams
        combined = layers.Add()([value, layers.Subtract()([advantage, layers.Lambda(lambda x: tf.reduce_mean(x, axis=1))(advantage)])])
        model = Model(inputs, combined)
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.alpha), loss='mse')
        return model

# Create the environment (e.g., a simple gym environment for simulation)
env = gym.make("CartPole-v1")
state_size = env.observation_space.shape[0]
action_size = env.action_space.n

# Initialize the agent and start training
agent = DQNAgent(state_size, action_size)  # Change to DDQNAgent or DuelingDQNAgent for other strategies

# Training the agent
def train(agent, episodes=1000, batch_size=32):
    for e in range(episodes):
        state = env.reset()
        state = np.reshape(state, [1, state_size])
        done = False
        while not done:
            action = agent.act(state)
            next_state, reward, done, _ = env.step(action)
            next_state = np.reshape(next_state, [1, state_size])
            agent.remember(state, action, reward, next_state, done)
            state = next_state
            if len(agent.memory) > batch_size:
                agent.replay(batch_size)

train(agent)  # Call the function to train the agent

print("Training complete!")
