import numpy as np
import random
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam

# Environment setup
grid_size = 5
goal = (4, 4)  # Goal at the bottom-right corner
obstacles = [(2, 2), (1, 3), (3, 1)]  # Some obstacles in the grid

# Actions (up, down, left, right)
actions = [(0,1), (0,-1), (1,0), (-1,0)]

# Deep Q-Learning Model (Neural Network)
def create_model():
    model = Sequential([
        Dense(24, input_dim=2, activation='relu'),
        Dense(24, activation='relu'),
        Dense(len(actions), activation='linear')  # One output for each action
    ])
    model.compile(loss='mse', optimizer=Adam(lr=0.001))
    return model

# Environment functions
def is_valid_state(state):
    return 0 <= state[0] < grid_size and 0 <= state[1] < grid_size and state not in obstacles

def get_state_as_input(state):
    return np.array([state], dtype=np.float32)

def get_reward(state):
    if state == goal:
        return 1  # Reward for reaching the goal
    elif state in obstacles:
        return -1  # Penalty for hitting an obstacle
    return -0.1  # Small penalty for each step to encourage faster solutions

# Deep Q-Learning agent
class DQNAgent:
    def __init__(self):
        self.model = create_model()
        self.epsilon = 0.2  # Exploration rate
        self.gamma = 0.95  # Discount factor
        self.learning_rate = 0.001
        self.memory = []
        self.batch_size = 32

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.choice(range(len(actions)))  # Random action (exploration)
        q_values = self.model.predict(get_state_as_input(state))
        return np.argmax(q_values[0])  # Best action (exploitation)

    def train(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                target = reward + self.gamma * np.max(self.model.predict(get_state_as_input(next_state))[0])
            target_f = self.model.predict(get_state_as_input(state))
            target_f[0][action] = target
            self.model.fit(get_state_as_input(state), target_f, epochs=1, verbose=0)

# Training the agent
def train_agent():
    agent = DQNAgent()
    episodes = 500
    for episode in range(episodes):
        state = (0, 0)  # Start position
        done = False
        while not done:
            action = agent.act(state)
            next_state = (state[0] + actions[action][0], state[1] + actions[action][1])
            if not is_valid_state(next_state):
                next_state = state  # If invalid move, stay in place

            reward = get_reward(next_state)
            done = next_state == goal  # End if goal is reached
            agent.remember(state, action, reward, next_state, done)
            agent.train()  # Train the model after each step

            state = next_state
        print(f"Episode {episode + 1}/{episodes} completed.")
    
    return agent

# Play and visualize the trained agent
def play_trained_agent(agent):
    state = (0, 0)  # Start position
    done = False
    while not done:
        print(f"Current state: {state}")
        action = agent.act(state)
        next_state = (state[0] + actions[action][0], state[1] + actions[action][1])
        if not is_valid_state(next_state):
            next_state = state  # If invalid move, stay in place
        
        reward = get_reward(next_state)
        print(f"Action: {actions[action]} => New State: {next_state} => Reward: {reward}")
        
        state = next_state
        if state == goal:
            print("Goal Reached!")
            done = True

# Training and testing the agent
agent = train_agent()
play_trained_agent(agent)
