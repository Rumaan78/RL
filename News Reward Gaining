import numpy as np
Q = np.zeros([5, 3])
gamma, alpha = 0.9, 0.1 
for _ in range(1000):
    state = np.random.randint(0, 5)
    action = np.random.randint(0, 3) 
    reward = np.random.choice([1, 0]) 
    next_state = (state + 1) % 5
    Q[state, action] += alpha * (reward + gamma * np.max(Q[next_state]) - Q[state, action])
print(Q)
