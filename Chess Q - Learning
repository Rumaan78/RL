import numpy as np
import random
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam
import chess
import chess.engine

# Define the model (Deep Q-Network)
def create_model():
    model = Sequential([
        Dense(128, input_dim=64, activation='relu'),  # Flatten board state to 64 input features
        Dense(128, activation='relu'),
        Dense(64, activation='linear')  # Output Q-values for each potential move
    ])
    model.compile(loss='mse', optimizer=Adam(lr=0.001))
    return model

# State: Chess board representation (8x8 grid flattened to 64)
def board_to_input(board):
    # Simple representation: 0 for empty, 1 for white piece, -1 for black piece
    state = np.zeros(64)
    for i in range(64):
        square = chess.square(i % 8, i // 8)  # Convert index to square
        piece = board.piece_at(square)
        if piece:
            state[i] = 1 if piece.color == chess.WHITE else -1
    return state

# Reward system: 1 for winning, -1 for losing, 0 for other situations
def get_reward(board, game_result):
    if game_result == chess.engine.LimitTimeError:
        return 0
    if game_result == chess.engine.Result.WIN:
        return 1
    elif game_result == chess.engine.Result.LOSS:
        return -1
    return 0

# Agent for chess game using Deep Q-Learning
class ChessAgent:
    def __init__(self):
        self.model = create_model()
        self.epsilon = 0.1  # Exploration rate
        self.gamma = 0.9    # Discount factor for future rewards
        self.memory = []
        self.batch_size = 32

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.randint(0, 63)  # Explore: Random move
        q_values = self.model.predict(state.reshape(1, 64))
        return np.argmax(q_values[0])  # Exploit: Best action

    def train(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                target = reward + self.gamma * np.max(self.model.predict(next_state.reshape(1, 64))[0])
            target_f = self.model.predict(state.reshape(1, 64))
            target_f[0][action] = target
            self.model.fit(state.reshape(1, 64), target_f, epochs=1, verbose=0)

# Train the agent with simple chess environment
def train_chess_agent():
    agent = ChessAgent()
    board = chess.Board()
    for episode in range(500):  # Train for 500 episodes
        board.set_fen(chess.STARTING_FEN)  # Reset the board at the start of each episode
        done = False
        while not done:
            state = board_to_input(board)
            action = agent.act(state)
            move = chess.Move.from_uci(chess.square_name(action))
            if move in board.legal_moves:
                board.push(move)
                reward = get_reward(board, board.result())
                done = board.is_game_over()
                agent.remember(state, action, reward, board_to_input(board), done)
                agent.train()  # Train the model after each move

# Main function to train the agent
train_chess_agent()
