import gym
from stable_baselines3 import PPO

env = gym.make("CartPole-v1")  # Simulate customer approval scenario
model = PPO("MlpPolicy", env, verbose=0)
model.learn(total_timesteps=5000)

obs = env.reset()
total_reward = 0
for _ in range(100):
    action, _ = model.predict(obs)
    obs, reward, done, _ = env.step(action)
    total_reward += reward
    if done: break

print("PPO Profit Score:", total_reward)
