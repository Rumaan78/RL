import numpy as np

V = np.zeros((3, 4))
R = np.zeros((3, 4))
R[0, 3] = 10
R[1, 3] = -10
g = 0.9

for _ in range(10):
  for i in range(3):
    for j in range(4):
      if (i, j) in [(0, 3), (1, 3)]: continue
      V[i, j] = max([R[i2, j2] + g * V[i2, j2]
        for (i2, j2) in [(i-1,j),(i+1,j),(i,j-1),(i,j+1)]
        if 0<=i2<3 and 0<=j2<4])

print(V.round(1))
