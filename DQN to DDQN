import numpy as np
import random
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam
import chess

# Define the model (Deep Q-Network)
def create_model():
    model = Sequential([
        Dense(128, input_dim=64, activation='relu'),
        Dense(128, activation='relu'),
        Dense(64, activation='linear')  # Output Q-values for each possible action (64 moves)
    ])
    model.compile(loss='mse', optimizer=Adam(lr=0.001))
    return model

# Convert board to a 1D array
def board_to_input(board):
    state = np.zeros(64)
    for i in range(64):
        square = chess.square(i % 8, i // 8)
        piece = board.piece_at(square)
        if piece:
            state[i] = 1 if piece.color == chess.WHITE else -1
    return state

# Reward function
def get_reward(board, game_result):
    if game_result == "win":
        return 1
    elif game_result == "loss":
        return -1
    return 0

# Define Double Deep Q-Learning Agent
class DDQNAgent:
    def __init__(self):
        self.online_model = create_model()  # Model for selecting actions
        self.target_model = create_model()  # Model for evaluating actions
        self.epsilon = 0.1  # Exploration rate
        self.gamma = 0.9    # Discount factor
        self.memory = []
        self.batch_size = 32

    def remember(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def act(self, state):
        if np.random.rand() <= self.epsilon:
            return random.randint(0, 63)  # Random action for exploration
        q_values = self.online_model.predict(state.reshape(1, 64))
        return np.argmax(q_values[0])  # Greedy action selection

    def replay(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        for state, action, reward, next_state, done in batch:
            target = reward
            if not done:
                next_action = np.argmax(self.online_model.predict(next_state.reshape(1, 64))[0])  # Best action from online model
                target = reward + self.gamma * self.target_model.predict(next_state.reshape(1, 64))[0][next_action]  # Use target network for Q evaluation
            target_f = self.online_model.predict(state.reshape(1, 64))
            target_f[0][action] = target
            self.online_model.fit(state.reshape(1, 64), target_f, epochs=1, verbose=0)

    def update_target(self):
        self.target_model.set_weights(self.online_model.get_weights())  # Copy online model weights to target model

# Training loop for DDQN
def train_ddqn_agent():
    agent = DDQNAgent()
    board = chess.Board()
    for episode in range(1000):  # Train for 1000 episodes
        board.set_fen(chess.STARTING_FEN)  # Reset the chess board for each episode
        done = False
        while not done:
            state = board_to_input(board)
            action = agent.act(state)
            move = chess.Move.from_uci(chess.square_name(action))
            if move in board.legal_moves:
                board.push(move)
                reward = get_reward(board, board.result())
                done = board.is_game_over()
                agent.remember(state, action, reward, board_to_input(board), done)
                agent.replay()  # Train the model after each move
        if episode % 10 == 0:
            agent.update_target()  # Update the target model every 10 episodes

# Run the training
train_ddqn_agent()
